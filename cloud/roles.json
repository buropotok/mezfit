{
  "roles": {
    "coach": {
      "displayName": "Coach",
      "description": "Can author assigned PLAN, request scheduling, and edit set FACT; session lifecycle stays privileged",
      "sortOrder": 1,
      "permissions": {
        "add": ["workoutScheduleRequests"],
        "manage": [
          "trainingPlans",
          "programPhases",
          "programDays",
          "programExercises",
          "programSets"
        ],
        "update": {
          "sessionSetFacts": [
            "actualReps",
            "actualWeightKg",
            "actualDurationSeconds",
            "actualDistanceMeters",
            "setLabel",
            "rpe",
            "comment",
            "bands",
            "setStatus"
          ]
        }
      }
    },
    "client": {
      "displayName": "Client",
      "description": "Can read assigned PLAN, request scheduling, and edit set FACT; session lifecycle stays privileged",
      "sortOrder": 2,
      "permissions": {
        "add": ["workoutScheduleRequests"],
        "update": {
          "sessionSetFacts": [
            "actualReps",
            "actualWeightKg",
            "actualDurationSeconds",
            "actualDistanceMeters",
            "setLabel",
            "rpe",
            "comment",
            "bands",
            "setStatus"
          ]
        }
      }
    }
  }
}
