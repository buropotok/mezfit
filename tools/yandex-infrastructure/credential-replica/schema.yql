CREATE TABLE IF NOT EXISTS credential_replica (
  user_id Uint64,
  app_user_id Uint64,
  telegram_id Uint64,
  login Utf8,
  pass_hash Utf8,
  revision Uint64,
  state Utf8,
  PRIMARY KEY (user_id)
);

CREATE TABLE IF NOT EXISTS credential_replica_login (
  login Utf8,
  user_id Uint64,
  PRIMARY KEY (login)
);

CREATE TABLE IF NOT EXISTS credential_replica_telegram (
  telegram_id Uint64,
  user_id Uint64,
  PRIMARY KEY (telegram_id)
);
