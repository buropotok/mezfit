      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::mezfit-comm-poc-20261106/mvp-media/*"
    },
    {
      "Sid": "MezfitMvpConditionalPut",
      "Effect": "Allow",
      "Principal": "*",
