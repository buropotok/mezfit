{
  "Version": "2025-12-24",
  "Statement": [
    {
      "Sid": "MezfitMvpRead",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::mezfit-comm-poc-20261106/mvp-media/*",
      "Condition": { "Bool": { "aws:SecureTransport": "true" } }
    },
    {
      "Sid": "MezfitMvpSignedPut",
      "Effect": "Allow",
      "Principal": { "CanonicalUser": "REPLACE-WITH-EXISTING-SIGNER-SA-ID" },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::mezfit-comm-poc-20261106/mvp-media/*",
      "Condition": {
        "Null": { "s3:if-none-match": "false" },
        "Bool": { "aws:SecureTransport": "true" }
      }
    }
  ]
}
